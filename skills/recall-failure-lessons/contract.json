{
  "contract_version": 8,
  "policy_kind": "recall_failure",
  "skill": {
    "name": "recall-failure-lessons",
    "description": "Use before risky or recurring work, or when a current task resembles a previously recorded failure and the task provides concrete evidence for a bounded lookup."
  },
  "policy": {
    "tool": "recall_failure_lessons",
    "fallback_command": "failure-memory",
    "fallback_arguments": [
      "recall"
    ],
    "default_mode": "auto",
    "selection": "relevance_threshold_then_cluster_collapse_then_top_k",
    "default_top_k": "adaptive",
    "maximum_top_k": 3,
    "default_min_relevance": "retrieval_profile_calibrated",
    "call_limit": 1,
    "required_context": "text",
    "optional_discriminators": [
      "expected_invariant",
      "controllable_cause",
      "prevention_action",
      "component"
    ],
    "minimum_query": {"all": ["text"]},
    "input_fields": {
      "text": {"type": "string", "required": true, "nonempty": true, "maximum_bytes": 4000},
      "expected_invariant": {"type": "string", "required": false, "nonempty_when_present": true, "maximum_bytes": 4000},
      "controllable_cause": {"type": "string", "required": false, "nonempty_when_present": true, "maximum_bytes": 4000},
      "prevention_action": {"type": "string", "required": false, "nonempty_when_present": true, "maximum_bytes": 4000},
      "component": {"type": "string", "required": false, "nonempty_when_present": true, "maximum_bytes": 4000},
      "mode": {
        "type": "string",
        "required": false,
        "allowed": ["auto", "exact", "lexical", "semantic", "hybrid"]
      },
      "top_k": {
        "type": "integer",
        "required": false,
        "minimum": 1,
        "maximum": 3,
        "semantics": "maximum_results_after_threshold_and_cluster_collapse"
      },
      "min_relevance": {
        "type": "number",
        "required": false,
        "minimum": 0,
        "maximum": 1,
        "semantics": "minimum_calibrated_relevance_before_top_k; zero selects_the_profile_default"
      }
    },
    "allow_unknown_fields": false,
    "clarify_for_recall": false,
    "fallback_only_when": "The named tool capability is absent before invocation; never after timeout or ambiguous failure.",
    "post_invocation_failure": "Do not retry or fall back. Continue without memory guidance and report one short capability error only when relevant.",
    "sensitive_exclusions": [
      "raw prompts",
      "secrets",
      "personal data",
      "unnecessary user text",
      "unnecessary paths"
    ],
    "allow_query_broadening": false,
    "allow_empty_result": true,
    "never_lower_threshold_to_fill_top_k": true,
    "outcome_tool": "report_memory_outcome",
    "outcome_only_when_verified": true,
    "allow_dependency_install": false,
    "lesson_authority": "proposed caution"
  }
}
