{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "failure-memory hook --harness claude-code --event session-start",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "failure-memory hook --harness claude-code --event user-prompt-submit",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
