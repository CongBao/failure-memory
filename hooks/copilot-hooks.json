{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "failure-memory hook --harness copilot-cli --event session-start",
        "timeoutSec": 2
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "command": "failure-memory hook --harness copilot-cli --event user-prompt-transformed",
        "timeoutSec": 2
      }
    ]
  }
}
