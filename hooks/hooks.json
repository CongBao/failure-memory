{
  "description": "Bounded Failure Memory session guidance; never stores prompts or writes lessons.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "failure-memory hook --harness codex --event session-start",
            "timeout": 2,
            "additionalContextLimit": 500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "failure-memory hook --harness codex --event user-prompt-submit",
            "timeout": 2,
            "additionalContextLimit": 300
          }
        ]
      }
    ]
  }
}
